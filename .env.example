# Copy this file to .env and fill in your values for local development.
# On Vercel, set these as Environment Variables in the dashboard.

# Required: Generate a strong secret key
# You can generate one with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here

# Set to True for local development, False for production
DEBUG=True

# Required for production on Vercel — use PostgreSQL from Neon.tech or Supabase
# Format: postgres://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=

# Optional: set to your Vercel deployment URL (auto-set by Vercel)
# VERCEL_URL=your-app.vercel.app
